# The address to bind the server to
UDP_BIND_ADDRESS=0.0.0.0:8080
# Client versions that are compatible with this server
ALLOWED_VERSIONS=1.1.0_beta
# A local list of app IDs that are allowed to connect
# WHITELIST = my_app,another_app,etc
WHITELIST=
# A remote endpoint to check if an app is allowed to connect.
# Leave empty to use the local whitelist (see above).
REMOTE_WHITELIST_ENDPOINT=
# The API token required to query the remote whitelist endpoint (see above).
REMOTE_WHITELIST_TOKEN=
# The ID of this relay, which will be prepended to generated room IDs.
# This can be used to figure out which relay a room exists on.
RELAY_ID=LOCAL

# --- Egress limits ---------------------------------------------------------
# 0 is rejected; use a large number for "unlimited".

# Egress to a single client, in bytes/sec. 64 KiB/s.
MAX_CLIENT_BYTES_PER_SEC=65536
# Egress across all clients, in bytes/sec. 2 MB/s.
MAX_GLOBAL_BYTES_PER_SEC=2000000
# Relayed gameplay egress per day, in bytes. 5 GB. This is what bounds the bill.
MAX_DAILY_BYTES=5000000000
# Control-plane egress per day, in bytes, on top of MAX_DAILY_BYTES. 250 MB.
MAX_DAILY_CONTROL_BYTES=250000000
# Window the rate limits are sliced into, in ms.
TRAFFIC_INTERVAL_MS=250
# Total egress to one session before it is dropped, in bytes. 2 GB.
MAX_SESSION_BYTES=2000000000
# How long a single session may live, in seconds. 4 hours.
MAX_SESSION_SECS=14400